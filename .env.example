# Токен від @BotFather
BOT_TOKEN=123456:ABC...
# Telegram ID власника (дізнатися: @userinfobot). Кілька власників — через кому: 111,222
OWNER_ID=0
# Канал-джерело (публічний username без @)
SOURCE_CHANNEL=pat_cherkasyoblenergo
# Як часто перевіряти канал, секунд
POLL_INTERVAL=60
# Де зберігати базу
DB_PATH=data/bot.db
# Зовнішній нагляд (необов'язково): адреса пінгу з healthchecks.io — сповістить, якщо бот або сервер зупинився
HEALTHCHECK_URL=
# О котрій годині (за Києвом) щодня надсилати бекап бази власникам
BACKUP_HOUR=4
